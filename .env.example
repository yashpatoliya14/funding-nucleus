# Binance USDⓈ-M Futures API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Bybit V5 Linear USDT Perpetuals API credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Telegram Bot Notification Settings (Primary Monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MONITORING_ENABLED=true
TELEGRAM_MONITORING_DURATION_DAYS=3

# Dynamic Capital Margin Setting
# Set ONLY the USDT margin you want to risk per leg (e.g. 10).
# The bot dynamically detects the coin's maximum common leverage (e.g. 20x) and calculates:
# Position Notional = TRADE_MARGIN_PER_LEG_USD * Common Max Leverage (e.g. $10 * 20 = $200)
TRADE_MARGIN_PER_LEG_USD=10

# Application Configuration File Path
CONFIG_PATH=./config/config.live.yaml
 